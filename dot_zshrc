mdview() {
  local file
  file=$(find . -name "*.md" | fzf --preview 'glow -s dark {}' --preview-window=right:60%)
  
  # Only run glow if a file was actually selected (prevents error on ESC)
  if [[ -n "$file" ]]; then
    glow -p "$file"
  fi
}

